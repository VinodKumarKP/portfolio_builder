---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT } from '../config';
import { marked } from 'marked';

// Helper to ensure base url works correctly
const base = import.meta.env.BASE_URL;
const getUrl = (path: string) => {
  return path.startsWith('/') ? `${base === '/' ? '' : base}${path}` : path;
};
---

<BaseLayout title="About">
  <style>
    .about-container {
      max-width: 900px;
      margin: 0 auto;
      padding-bottom: 4rem;
    }

    .profile-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 4rem;
    }

    @media (min-width: 768px) {
      .profile-header {
        flex-direction: row;
        text-align: left;
        gap: 3rem;
      }
    }

    .profile-image {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--color-bg);
      box-shadow: 0 10px 30px rgba(0, 102, 204, 0.2);
      margin-bottom: 2rem;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      padding: 4px;
    }

    @media (min-width: 768px) {
      .profile-image {
        margin-bottom: 0;
        width: 240px;
        height: 240px;
      }
    }

    .profile-title h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-weight: 800;
    }

    .profile-title h2 {
      font-size: 1.5rem;
      color: var(--color-text-light);
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .about-card {
      padding: 2.5rem;
      background: var(--color-bg-light);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      margin-bottom: 2.5rem;
    }

    @media (prefers-color-scheme: dark) {
      .about-card {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      }
    }

    .about-card h3 {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
      color: var(--color-accent);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .about-card p {
      font-size: 1.1rem;
      line-height: 1.8;
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .skill-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .skill-list li {
      margin-bottom: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-text-light);
      font-size: 1.05rem;
    }

    .skill-list li::before {
      content: '→';
      color: var(--color-accent);
      font-weight: bold;
    }

    .cert-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .cert-tag {
      padding: 8px 16px;
      background: rgba(0, 102, 204, 0.05);
      border: 1px solid rgba(0, 102, 204, 0.2);
      border-radius: 20px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-accent);
    }

    .links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    
    @media (min-width: 768px) {
      .links {
        justify-content: flex-start;
      }
    }

    .links a {
      display: inline-block;
      padding: 10px 24px;
      background: linear-gradient(135deg, var(--color-accent), #8a2be2);
      color: white;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(138, 43, 226, 0.2);
    }

    .links a:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(138, 43, 226, 0.4);
    }
    
    .links a.secondary {
      background: transparent;
      border: 2px solid var(--color-accent);
      color: var(--color-accent);
      box-shadow: none;
    }
    .links a.secondary:hover {
      background: rgba(0, 102, 204, 0.1);
    }
  </style>

  <div class="about-container">
    <div class="profile-header">
      <img src={getUrl(ABOUT.image)} alt={ABOUT.title} class="profile-image" />
      <div class="profile-title">
        <h1>{ABOUT.title}</h1>
        <h2>{ABOUT.role}</h2>
        <div class="links">
          {ABOUT.socialLinks.map(link => (
            <a href={link.url} target="_blank" class={link.primary ? '' : 'secondary'}>{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="about-card">
      <h3>Professional Journey</h3>
      {ABOUT.journey.split('\n\n').map(paragraph => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="about-card">
      <h3>Core Expertise</h3>
      <div class="skills-grid">
        <ul class="skill-list">
          {ABOUT.coreExpertise.slice(0, Math.ceil(ABOUT.coreExpertise.length / 2)).map(skill => (
            <li>{skill}</li>
          ))}
        </ul>
        <ul class="skill-list">
          {ABOUT.coreExpertise.slice(Math.ceil(ABOUT.coreExpertise.length / 2)).map(skill => (
            <li>{skill}</li>
          ))}
        </ul>
      </div>
    </div>

    {ABOUT.leadership && (
    <div class="about-card">
      <h3>Leadership & Mentorship</h3>
      <p>{ABOUT.leadership.description}</p>
      <div class="skills-grid" style="display: block;">
        <ul class="skill-list">
          {ABOUT.leadership.points.map(point => (
            <li set:html={marked.parseInline(point)}></li>
          ))}
        </ul>
      </div>
    </div>
    )}

    {ABOUT.certifications && ABOUT.certifications.length > 0 && (
    <div class="about-card">
      <h3>Certifications</h3>
      <div class="cert-tags">
        {ABOUT.certifications.map(cert => (
          <span class="cert-tag">{cert}</span>
        ))}
      </div>
    </div>
    )}

  </div>
</BaseLayout>
