---
import { SITE } from '../config';

export interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

// Helper to ensure base url works correctly
const base = import.meta.env.BASE_URL;
const getUrl = (path: string) => {
  return path.startsWith('/') ? `${base === '/' ? '' : base}${path}` : path;
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --color-bg: #ffffff;
        --color-text: #1a1a1a;
        --color-text-light: #666;
        --color-border: #e5e5e5;
        --color-accent: #0066cc;
        --color-accent-dark: #0052a3;
        --color-success: #28a745;
        --color-bg-light: #f8f9fa;
        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 1.5rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #1a1a1a;
          --color-text: #ffffff;
          --color-text-light: #aaa;
          --color-border: #333;
          --color-bg-light: #2d2d2d;
        }
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }

      header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        padding: 1.2rem 0;
        position: sticky;
        top: 0;
        background-color: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        z-index: 100;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      @media (prefers-color-scheme: dark) {
        header {
          background-color: rgba(26, 26, 26, 0.75);
          border-bottom: 1px solid rgba(255, 255, 255, 0.05);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        }
      }

      nav {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--color-accent);
      }

      .nav-links {
        display: flex;
        gap: var(--space-lg);
        list-style: none;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.95rem;
        font-weight: 500;
        position: relative;
        padding-bottom: 4px;
        transition: color 0.3s ease;
      }

      .nav-links a::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: 0;
        left: 0;
        background: linear-gradient(135deg, var(--color-accent), #8a2be2);
        transition: width 0.3s ease;
        border-radius: 2px;
      }

      .nav-links a:hover {
        color: var(--color-accent);
      }

      .nav-links a:hover::after {
        width: 100%;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: var(--space-lg);
      }

      footer {
        border-top: 1px solid var(--color-border);
        padding: var(--space-xl) var(--space-lg);
        margin-top: var(--space-xl);
        text-align: center;
        color: var(--color-text-light);
        font-size: 0.9rem;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      button, .btn {
        display: inline-block;
        padding: var(--space-sm) var(--space-md);
        background-color: var(--color-accent);
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.2s;
        text-decoration: none;
      }

      button:hover, .btn:hover {
        background-color: var(--color-accent-dark);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href={getUrl("/")} class="logo">{SITE.title.split('-')[0].trim()}</a>
        <ul class="nav-links">
          <li><a href={getUrl("/")}>Home</a></li>
          <li><a href={getUrl("/projects")}>Projects</a></li>
          <li><a href={getUrl("/about")}>About</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} {SITE.title.split('-')[0].trim()}. All rights reserved.</p>
    </footer>
  </body>
</html>
